# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.listik-dev.*.log
src-tauri/target-release/
.pnpm-store/

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# sidecar (Python)
sidecar/.venv
sidecar/__pycache__
sidecar/*.pyc
sidecar/listik_vec.db

# animation du logo (Remotion, sous-projet npm)
motion/node_modules
motion/out

# Générée par scripts/nouveautes.mjs à la publication du site
site/nouveautes/

# Cache du build de release (scripts/build-signed-release.ps1, NEXT_DIST_DIR)
/.next-release/
